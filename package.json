{
  "name": "astro-opinionated-template",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm design:generate && pnpm i18n:generate && turbo run build",
    "check": "pnpm design:generate && pnpm design:check && pnpm i18n:check && pnpm fmt:check && pnpm lint && pnpm stylelint && pnpm typecheck && pnpm test && pnpm build",
    "design:check": "node scripts/design-tokens.mjs check",
    "design:generate": "node scripts/design-tokens.mjs generate",
    "design:watch": "node scripts/design-tokens.mjs watch",
    "dev": "pnpm design:generate && pnpm i18n:generate && concurrently --kill-others-on-fail --names design,i18n,web \"pnpm design:watch\" \"pnpm i18n:watch\" \"turbo run dev\"",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "i18n:check": "pnpm --filter @workspace/web i18n:check",
    "i18n:generate": "pnpm --filter @workspace/web i18n:generate",
    "i18n:watch": "pnpm --filter @workspace/web i18n:watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "pnpm design:generate",
    "stylelint": "stylelint \"apps/web/src/**/*.{astro,css,html,md,mdx}\"",
    "stylelint:fix": "pnpm stylelint --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "turbo run check"
  },
  "devDependencies": {
    "@dreamsicle.io/stylelint-config-tailwindcss": "^1.2.2",
    "@eslint/js": "^10.0.1",
    "@google/design.md": "0.3.0",
    "@mdx-js/language-server": "^0.6.3",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^2.1.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-mdx": "^3.8.1",
    "globals": "^17.3.0",
    "postcss-html": "^1.8.1",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "stylelint": "^17.14.0",
    "stylelint-config-html": "^1.1.0",
    "stylelint-config-standard": "^40.0.0",
    "turbo": "^2.10.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "allowedVersions": {
        "eslint-plugin-jsx-a11y>eslint": "10"
      }
    }
  }
}
