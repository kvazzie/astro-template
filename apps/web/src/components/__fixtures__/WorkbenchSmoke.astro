---
export interface Props {
  message: string;
  locale: string;
  siteUrl: string;
}

const { message, locale, siteUrl } = Astro.props;
---

<article
  class="max-w-md rounded-box border border-base-300 bg-base-100 p-6 text-base-content"
  lang={locale}>
  <p class="text-sm font-medium text-primary">{siteUrl}</p>
  <p class="mt-2 text-xl font-semibold">{message}</p>
</article>
