{
  "$schema": "https://turborepo.dev/schema.json",
  "globalDependencies": ["DESIGN.md", ".env*"],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "check": {
      "outputs": []
    },
    "fmt": {
      "cache": false,
      "outputs": []
    },
    "fmt:check": {
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "cache": false,
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
