root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 79

[*.{md,mdx}]
max_line_length = off
trim_trailing_whitespace = false

[*.{bat,cmd,ps1}]
end_of_line = crlf

[{*.min.js,*.min.css,dist/**,.astro/**,node_modules/**}]
indent_style = unset
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
